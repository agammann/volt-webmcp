{
  "name": "volt-webmcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native && node scripts/prepare-sites.mjs && node scripts/verify-sites-build.mjs",
    "serve:build": "node scripts/serve-build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:webmcp": "playwright test --config playwright.webmcp.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "security:audit": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
